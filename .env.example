# Set a strong local password before starting Compose. Never commit .env.
POSTGRES_DB=chainlink
POSTGRES_USER=chainlink
POSTGRES_PASSWORD=
API_PORT=8000
# For host Python development, use a separately accessible local PostgreSQL:
# DATABASE_URL=postgresql+psycopg://chainlink:URL_ENCODED_PASSWORD@127.0.0.1:5432/chainlink

# Secure cookies are required for HTTPS. Set false ONLY for local HTTP development.
SESSION_COOKIE_SECURE=true
# Absolute session lifetime (1–168 hours); no sliding renewal.
SESSION_HOURS=12
